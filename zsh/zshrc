# ============ Oh My Zsh ============
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Using Starship instead
plugins=(git)
source $ZSH/oh-my-zsh.sh

# ============ History ============
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# ============ Directory Navigation ============
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_MINUS
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# ============ PATH ============
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$HOME/.pulumi/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ============ Aliases ============
alias ll='eza -lah --icons=always'
alias la='eza -la --icons=always'
alias ls='eza --icons=always'
alias lt='eza --tree --level=2 --icons=always'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias mkdir='mkdir -pv'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias history='history -i'
alias path='echo $PATH | tr ":" "\n"'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias reload='source ~/.zshrc'
alias zshrc='${EDITOR:-nano} ~/.zshrc'
alias vim='nvim'
alias vi='nvim'
alias cat='bat'
alias preview='glow'
alias help='tldr'
alias dl='cd ~/Downloads'
alias dt='cd ~/Desktop'
alias docs='cd ~/Documents'
alias gs='git status'
alias gd='git diff'
alias gdc='git diff --cached'
alias gl='git log --oneline --graph --decorate -20'
alias gla='git log --oneline --graph --decorate --all -20'
alias fixmouse="printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l'"
alias claude-yolo='claude --dangerously-skip-permissions'
alias show='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
alias hide='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'

# dotfiles
export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
alias dots='cd $DOTFILES_DIR'
alias dotstat='cd $DOTFILES_DIR && git status'
alias dotdiff='cd $DOTFILES_DIR && git diff'
alias dotsave='cd $DOTFILES_DIR && git add -A && git commit -m "Update configs $(date +%Y-%m-%d)" && git push'

# ============ Functions ============
mkcd() { mkdir -p "$1" && cd "$1"; }
backup() { cp "$1" "$1.backup-$(date +%Y%m%d-%H%M%S)"; }
f() { find . -name "*$1*" 2>/dev/null; }
h() { history | grep "$1"; }
csv() { column -s, -t < "$1" | less -S; }
myip() { curl -s https://ipinfo.io/ip; echo; }

extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"    ;;
            *.tar.gz)    tar xzf "$1"    ;;
            *.bz2)       bunzip2 "$1"    ;;
            *.rar)       unrar x "$1"    ;;
            *.gz)        gunzip "$1"     ;;
            *.tar)       tar xf "$1"     ;;
            *.tbz2)      tar xjf "$1"    ;;
            *.tgz)       tar xzf "$1"    ;;
            *.zip)       unzip "$1"      ;;
            *.Z)         uncompress "$1" ;;
            *.7z)        7z x "$1"       ;;
            *)           echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

chrome() {
    /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222 "$@" &>/dev/null &
    disown
}

keychain-add() {
    [ $# -ne 2 ] && echo "Usage: keychain-add <service> <value>" && return 1
    security add-generic-password -a "$USER" -s "$1" -w "$2" -U 2>&1
    echo "✅ '$1' stored in Keychain"
}
keychain-get() {
    [ $# -ne 1 ] && echo "Usage: keychain-get <service>" && return 1
    security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null
}

# ============ AWS Safety Wrapper ============
aws() {
    local profile="${AWS_PROFILE:-default}"
    local destructive=(delete terminate destroy remove rm stop shutdown reboot modify update create run start launch put apply deploy push upload change execute)
    local is_destructive=false
    for cmd in "${destructive[@]}"; do
        [[ " $@ " =~ " $cmd" ]] && is_destructive=true && break
    done
    if [[ "$profile" == *"prod"* ]] && [[ "$is_destructive" == true ]]; then
        echo "⚠️  WARNING: Running AWS command on PRODUCTION profile: $profile"
        echo "Command: aws $@"
        echo -n "Type 'yes' to continue: "
        read confirmation
        [[ "$confirmation" != "yes" ]] && echo "❌ Cancelled" && return 1
    fi
    command aws "$@"
}

pulumi() {
    local destructive=(up destroy refresh import delete)
    local is_destructive=false
    for cmd in "${destructive[@]}"; do
        [[ " $@ " =~ " $cmd" ]] && is_destructive=true && break
    done
    if [[ "$is_destructive" == true ]]; then
        local current_stack=$(command pulumi stack --show-name 2>/dev/null || echo "unknown")
        if [[ "$current_stack" == *"prod"* ]]; then
            echo "⚠️  WARNING: Running Pulumi on PRODUCTION stack: $current_stack"
            echo -n "Type 'yes' to continue: "
            read confirmation
            [[ "$confirmation" != "yes" ]] && echo "❌ Cancelled" && return 1
        fi
    fi
    command pulumi "$@"
}

# ============ FZF ============
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
    command -v fd >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
fi

# ============ Completion ============
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '%U%F{yellow}%d%f%u'
zstyle ':completion:*:warnings' format '%F{red}No matches found%f'

# ============ Key Bindings ============
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
stty -ixon

# ============ Tool Init ============
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# ============ Plugins ============
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ============ Local / Work Overrides ============
# Source work-specific or machine-specific config (never committed to dotfiles)
for _f in "$HOME/.zsh_runpod" "$HOME/.zsh_local" "$HOME/.zsh_secrets"; do
    [ -f "$_f" ] && source "$_f"
done
unset _f
