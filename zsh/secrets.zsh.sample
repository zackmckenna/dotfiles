# Copy this file to ~/.zsh_secrets (recommended) or zsh/secrets.zsh and update the
# values. This file is not sourced automatically; only the copied version is.
#
# Keep secrets out of version control. The dotfiles repository ignores the
# locations above to prevent accidental commits.

# --- Database URLs ---------------------------------------------------------
# To pull credentials from the macOS keychain, add a Generic Password entry
# named "runpod-db-dev" (and prod) that stores the full connection string.
# The helper functions in zshrc will read them automatically.
#
# security add-generic-password -a "$USER" -s runpod-db-dev -w 'mysql://...'
# security add-generic-password -a "$USER" -s runpod-db-prod -w 'mysql://...'

# Uncomment to hard-code values locally (not recommended):
# export DB_DEV="mysql://username:password@host/dev?sslaccept=strict"
# export DB_PROD="mysql://username:password@host/prod?sslaccept=strict"

# You can also export other private environment variables here.
# export SOME_TOKEN="..."
