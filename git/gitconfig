[user]
    # name = Your Name
    # email = your.email@example.com

[core]
    editor = nano
    excludesfile = ~/.gitignore_global

[color]
    ui = auto
    diff = auto
    status = auto
    branch = auto

[push]
    default = current

[pull]
    rebase = false

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    
[init]
    defaultBranch = main